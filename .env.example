# Copy this file to .env (and/or .env.local for personal overrides) and fill
# in real values. See README.md > Environment variables for details.

# Base URL of the Java backend that owns login, registration, and JWT
# issuance. Defaults to http://localhost:8090 if unset.
VITE_API_BASE_URL=http://localhost:8090

# Optional: base URL of a secondary backend to fall back to if
# VITE_API_BASE_URL fails its /actuator/health check at startup (checked via
# the backend-health Netlify Function). Leave unset to always use the
# primary URL with no health check.
# VITE_API_BASE_URL_FALLBACK=

# OAuth 2.0 Web client ID for Google Identity Services. Leave unset to hide
# the "Sign in with Google" button. Set this in .env.development, not .env.
# VITE_GOOGLE_CLIENT_ID=
